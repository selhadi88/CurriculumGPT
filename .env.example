# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://gurriculum:password@localhost:5432/gurriculum_db

# ── Model ─────────────────────────────────────────────────────────────────────
# Options: "bge" (recommended) or "custom"
MODEL_TYPE=bge
MODEL_CACHE_DIR=.model_cache
# Set to "cuda" or "cpu" — auto-detected if left empty
DEVICE=
# BGE backbone. Default BAAI/bge-large-en-v1.5 (~1.3GB, needs ~2GB RAM).
# Memory-constrained hosts can use BAAI/bge-small-en-v1.5 (~130MB).
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5

# ── External APIs ─────────────────────────────────────────────────────────────
# O*NET Web Services — free key at https://services.onetcenter.org/
ONET_API_KEY=

# USAJobs — free key at https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_EMAIL=your@email.com

# LLM labeling (scripts/build_dataset.py --llm) — Groq preferred (higher free-tier
# limits); GROQ_API_KEY_2 is an optional second key, used automatically once the
# first hits its daily token quota. Gemini is a fallback provider.
# Groq keys: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Backend ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated (or JSON array) list of allowed browser origins.
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000
# Optional: regex alternative, e.g. https://.*\.onrender\.com
CORS_ORIGIN_REGEX=
LOG_LEVEL=INFO
WORKERS=1

# ── Frontend (Vite exposes VITE_ prefixed vars) ───────────────────────────────
VITE_API_URL=http://localhost:7000
