# Flat node_modules (like npm) so binaries such as vite/esbuild resolve
# reliably inside containers where pnpm's symlinked store is awkward.
node-linker=hoisted
# Honor lifecycle scripts so the esbuild allow-list in package.json
# (pnpm.onlyBuiltDependencies) is applied and ERR_PNPM_IGNORED_BUILDS is avoided.
enable-pre-post-scripts=true
